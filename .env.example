# Application
APP_NAME="CRM MVP"
DEBUG=false
BASE_URL=http://localhost:8000

# PostgreSQL
# Used by docker-compose postgres service
POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1

# asyncpg driver required — use postgresql+asyncpg:// scheme
# Docker compose: use host "postgres". Local host scripts may use "localhost"
# if PostgreSQL is exposed on your machine.
DATABASE_URL=postgresql+asyncpg://crm_user:crm_password@postgres:5432/crm_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Telegram webhook
# TELEGRAM_PROJECT_ID — UUID of the project that receives messages from this bot.
# Must be set before registering the webhook with Telegram.
# If absent, incoming updates are logged and silently discarded (no retries triggered).
# TELEGRAM_PROJECT_ID=00000000-0000-0000-0000-000000000000

# TELEGRAM_BOT_TOKEN — used by scripts/seed_test_bot.py to store a bot token
# in the database. Do not commit real tokens.
# TELEGRAM_BOT_TOKEN=0000000000:replace_me

# TELEGRAM_WEBHOOK_SECRET — optional token passed to setWebhook(secret_token=...).
# When set, every incoming request is validated against the
# X-Telegram-Bot-Api-Secret-Token header. Leave commented out to disable.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# TELEGRAM_WEBHOOK_SECRET=change_me_in_production

# Buyer Telegram bot
# BUYER_BOT_TOKEN — separate private bot for buyer activation, links, spend, and stats.
# BUYER_BOT_USERNAME is required to generate invite deep-links in the CRM admin panel.
# BUYER_BOT_INTERNAL_TOKEN optionally protects internal analytics endpoints used by the bot.
# CLIENT_BOT_USERNAME optionally selects the client bot used for generated ref links.
# If CLIENT_BOT_USERNAME is empty, the worker uses the first configured Telegram bot in the buyer's project.
# BUYER_BOT_TOKEN=0000000000:replace_me
# BUYER_BOT_USERNAME=buyer_bot_username
# BUYER_BOT_INTERNAL_TOKEN=change_me_in_production
# CLIENT_BOT_USERNAME=client_bot_username
BUYER_BOT_POLL_TIMEOUT_SECONDS=25
BUYER_BOT_FSM_TTL_SECONDS=3600
