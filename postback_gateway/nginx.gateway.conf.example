# GATEWAY SERVER ONLY. Include in nginx http{} after adapting domain/cert paths.
limit_req_zone $binary_remote_addr zone=postback_ip:10m rate=5r/s;
limit_req_zone $server_name zone=postback_total:1m rate=50r/s;
limit_conn_zone $binary_remote_addr zone=postback_connections:10m;

server {
    listen 443 ssl;
    server_name postbacks.example.com;
    ssl_certificate /etc/letsencrypt/live/postbacks.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/postbacks.example.com/privkey.pem;
    server_tokens off;
    client_max_body_size 64k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    limit_req_status 429;
    limit_conn_status 429;

    location ~ "^/pb/[A-Za-z0-9_-]{32,128}$" {
        limit_except GET POST { deny all; }
        limit_req zone=postback_ip burst=20 nodelay;
        limit_req zone=postback_total burst=50 nodelay;
        limit_conn postback_connections 10;
        # Tokens in the URL are credentials. The application logs delivery IDs only.
        access_log off;
        error_log /dev/null;
        proxy_pass http://127.0.0.1:9080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
        proxy_request_buffering on;
        proxy_next_upstream off;
        proxy_hide_header Server;
    }
    location / { return 404; }
}
