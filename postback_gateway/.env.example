# GATEWAY SERVER ONLY. Never copy the main CRM .env here.
# WireGuard address of the main server, restricted to the relay routes by nginx.
CRM_ORIGIN=http://10.77.0.1:8099
# Generate independently: openssl rand -hex 32. Same value as POSTBACK_RELAY_SECRET on CRM.
RELAY_SECRET=REPLACE_WITH_A_NEW_RANDOM_64_HEX_SECRET
QUEUE_DATABASE=/data/queue.sqlite3
QUEUE_MAX_JOBS=100000
QUEUE_MIN_FREE_BYTES=268435456
MANIFEST_TTL_SECONDS=300
# One delivery at a time, at most 5/sec plus request time. Do not increase blindly.
SEND_INTERVAL_SECONDS=0.2
